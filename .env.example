# Local development only. AWS login credentials stay in the AWS SDK credential chain.
AWS_PROFILE=martian
AWS_REGION=us-east-1
MARTIAN_BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
MARTIAN_ASK_ENABLED=true
MARTIAN_ASK_ALLOWED_HOSTS=127.0.0.1,localhost,projectmartian.ai,www.projectmartian.ai
MARTIAN_ASK_CONCURRENCY=2
MARTIAN_ASK_REQUESTS_PER_HOUR=300
HOST=127.0.0.1
PORT=8766
PGHOST=127.0.0.1
PGPORT=5438
PGDATABASE=project_martian
PGUSER=project_martian_app
# Path to a private password file. Do not put passwords in this example.
PGPASSWORD_FILE=/absolute/private/path/app-password

# Radar is explicitly sample or live. Live stays empty until owner controls enable publication.
MARTIAN_RADAR_MODE=sample
MARTIAN_RADAR_INTAKE_ENABLED=false
MARTIAN_RADAR_INFERENCE_ENABLED=false
MARTIAN_RADAR_REGION=us-east-1
MARTIAN_RADAR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Worker uses its own PGUSER and PGPASSWORD_FILE; see docs/radar.md.
# Source token file variables and intake credentials are documented there.
